{
  "name": "one-platform-studio",
  "productName": "One Platform Studio",
  "version": "0.1.0",
  "description": "Layer-based desktop video editor with templates and an AI editing assistant",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win",
    "e2e": "node scripts/e2e.mjs"
  },
  "build": {
    "appId": "com.oneplatform.studio",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": "nsis",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**"
      ]
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.onnx"
        ]
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "1.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
